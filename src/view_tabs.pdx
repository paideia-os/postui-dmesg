  // Labels prefixed vtb_ per postui-dmesg fingerprint discipline.
  // ==========================================================================
  pub let view_tabs_next : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-dmesg.M3-002 (postui-dmesg#4): view_tabs_next advances the persistent tab selection by one mod 5. Pure leaf: no push/pop, no callee-save touched, no nested call. Body: lea r11, [rip + _vt_tabs_state] (r11 IS the target of the lea; the paideia-as internal r11-clobber-on-lea is the wanted result); mov rax, [r11 + 0] (current sel); add rax, 1; cmp rax, 5 (imm8 -- VTB_TAB_MOD); jb vtb_next_store (unsigned below-5 => in range); xor rax, rax (wrap 5 -> 0). vtb_next_store: mov [r11 + 0], rax. ret. Encoder discipline: no `test` (zero-check via cmp reg, 5 wraps at the boundary rather than a separate cmp reg, 0); no imul; no `and reg, imm`; no `cmp reg, [mem]` (the compare loads through rax first). Every immediate (0, 1, 5) fits imm8. Effect `!{mem}` (one load + one store on _vt_tabs_state). Labels prefixed vtb_ per fingerprint discipline. Return type () -- rax on return is 0 in the wrap path or the wrapped sel in the non-wrap path; caller must not rely on rax content (void).",
      block: {
        lea r11, [rip + _vt_tabs_state];
        mov rax, [r11 + 0];
        add rax, 1;
        cmp rax, 5;
        jb vtb_next_store;
        xor rax, rax;
      vtb_next_store:
        mov [r11 + 0], rax;
        ret;
      }
    }

  // ==========================================================================
  // view_tabs_prev() -> ()
  //
  // Retreat the selected-tab index: sel = (sel + 5 - 1) mod 5.
  // Wraps 0 -> 4.
  //
  // Contract:
  //   No args.
  //   -> rax                 undefined (void; caller must not rely
  //                          on it)
  //
  // Register plan: pure leaf. r11 = _vt_tabs_state address (same
  // r11-clobber-on-lea rationale as view_tabs_next). rax = working
  // sel value. No pushes, no nested call.
  //
  // Body computes the wrap via a special case for sel==0 rather than
  // via a mod: (a) load sel; (b) if sel == 0, replace with 4;
  // otherwise subtract 1; (c) store back. This avoids any negative-
  // intermediate concern in unsigned arithmetic and keeps the branch
  // count identical to view_tabs_next (one).
  //
  // Labels prefixed vtb_ per postui-dmesg fingerprint discipline.
  // ==========================================================================
  pub let view_tabs_prev : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-dmesg.M3-002 (postui-dmesg#4): view_tabs_prev retreats the persistent tab selection by one mod 5. Pure leaf: no push/pop, no callee-save touched, no nested call. Body: lea r11, [rip + _vt_tabs_state] (r11 IS the target of the lea; paideia-as internal r11-clobber-on-lea is the wanted result); mov rax, [r11 + 0] (current sel); cmp rax, 0 (imm8); jne vtb_prev_dec (non-zero => plain decrement); mov rax, 4 (wrap 0 -> 4, VTB_TAB_MOD - 1); jmp vtb_prev_store. vtb_prev_dec: sub rax, 1 (in-range decrement; unsigned safe because we branched on rax==0 above). vtb_prev_store: mov [r11 + 0], rax. ret. Encoder discipline: no `test` (zero-check via cmp reg, 0); no imul; no `and reg, imm`; no `cmp reg, [mem]` (the compare loads through rax first). Every immediate (0, 1, 4) fits imm8. Effect `!{mem}` (one load + one store on _vt_tabs_state). Labels prefixed vtb_ per fingerprint discipline. Return type () -- caller must not rely on rax content (void).",
      block: {
        lea r11, [rip + _vt_tabs_state];
        mov rax, [r11 + 0];
        cmp rax, 0;
        jne vtb_prev_dec;
        mov rax, 4;                                // wrap 0 -> 4
        jmp vtb_prev_store;
      vtb_prev_dec:
        sub rax, 1;
      vtb_prev_store:
        mov [r11 + 0], rax;
        ret;
      }
    }

  // ==========================================================================
  // view_tabs_selected() -> u64
  //
  // Return the currently-selected tab index (0..4).
  //
  // Contract:
  //   No args.
  //   -> rax                 _vt_tabs_state[0]  (0..4 under this
  //                          module's invariants; 0 pre-first
  //                          view_tabs_next / view_tabs_prev call
  //                          because _vt_tabs_state is BSS-zero on
  //                          load, corresponding to the "All" tab)
  //
  // Register plan: pure leaf. r11 = _vt_tabs_state address (same
  // r11-clobber-on-lea rationale as view_tabs_next). No pushes, no
  // nested call.
  //
  // No labels (straight-line, one branch-free path).
  // ==========================================================================
  pub let view_tabs_selected : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-dmesg.M3-002 (postui-dmesg#4): view_tabs_selected returns the persistent tab selection. Pure leaf: no push/pop, no callee-save touched, no nested call. Body: lea r11, [rip + _vt_tabs_state] (r11 IS the lea target; paideia-as internal r11-clobber is the wanted result); mov rax, [r11 + 0]; ret. Encoder discipline: no `test`, no imul, no `and reg, imm`, no `cmp reg, [mem]`, no branches. No immediates other than the +0 memory displacement (imm8). Effect `!{mem}` (one load from _vt_tabs_state). No labels (straight-line).",
      block: {
        lea r11, [rip + _vt_tabs_state];
        mov rax, [r11 + 0];
        ret;
      }
    }

  // ==========================================================================
  // view_tabs_match(selected, severity) -> u64
  //
  // Predicate: does a log_line with the given kernel LEVEL_* integer
  // match the filter for the given tab index? See §SEVERITY ENCODING
  // for the wire-format rationale.
  //
  // Contract:
  //   rdi = selected         a tab index in [0..5); values >= 5 map
  //                          to "no match" (returns 0)
  //   rsi = severity         the log_line.severity field (kernel
  //                          LEVEL_* integer in [0..6): PANIC=0,
  //                          ERROR=1, WARN=2, INFO=3, DEBUG=4,
  //                          TRACE=5)
  //   -> rax = 1             match (line survives the filter)
  //   -> rax = 0             no match (line filtered out)
  //
  // Truth table (rows = selected, cols = severity match):
  //   sel = 0 "All"    -> always 1  (matches every severity)
  //   sel = 1 "Panic"  -> 1 iff severity == 0  (LEVEL_PANIC)
  //   sel = 2 "Err"    -> 1 iff severity == 1  (LEVEL_ERROR)
  //   sel = 3 "Warn"   -> 1 iff severity == 2  (LEVEL_WARN)
  //   sel = 4 "Info"   -> 1 iff severity == 3  (LEVEL_INFO)
  //   sel >= 5         -> 0 (out of range; defensive)
  //
  // DEBUG (4) and TRACE (5) severities never match any surfaced tab
  // at this landing -- they fall through to the miss arm. A future
  // "Debug" or "All+verbose" tab landing extends VTB_TAB_COUNT and
  // adds arms here.
  //
  // Register plan: pure leaf. Uses rdi (selected), rsi (severity),
  // rax (return) only. No pushes, no callee-save touched, no nested
  // call, no memory access. All immediates (0..4) fit imm8.
  //
  // Implementation: dispatch by `selected` through a chain of cmp/je
  // branches. For 5 buckets, a jump-table is not warranted (the
  // branch chain fits in a handful of instructions and avoids the
  // indirect branch mispredict + rodata table entirely). Each match
  // arm sets rax = 0 or 1 by a single compare against `severity`
  // followed by a conditional load; the miss path falls through to
  // rax = 0 via xor.
  //
  // Labels prefixed vtb_ per postui-dmesg fingerprint discipline.
  // ==========================================================================
  pub let view_tabs_match : (u64, u64) -> u64 !{} @{} =
    fn (selected: u64) (severity: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "postui-dmesg.M3-002 (postui-dmesg#4) as corrected by postui-dmesg#8: view_tabs_match is the per-line severity filter predicate. Keys against the kernel LEVEL_* integer space per design/kernel/kernel-logging-substrate.md §3.2 (wire letter grammar 'P'/'E'/'W'/'I'/'D'/'T') and §4 (LEVEL_PANIC=0/ERROR=1/WARN=2/INFO=3/DEBUG=4/TRACE=5); the previous revision keyed against a fabricated syslog priority space (0/3/4/6) that never appeared in any paideia-os wire line -- #8 fixes that. Pure leaf: no push/pop, no callee-save touched, no nested call, no memory access -- register-only over rdi (selected), rsi (severity), rax (return). Body dispatches by `selected` (rdi) through a linear cmp/je chain, then per-arm compares `severity` (rsi) against the arm's expected LEVEL_* integer: sel=0 -> return 1 (all); sel=1 -> return (rsi==0)?1:0 (panic); sel=2 -> return (rsi==1)?1:0 (err); sel=3 -> return (rsi==2)?1:0 (warn); sel=4 -> return (rsi==3)?1:0 (info); sel>=5 -> return 0 (defensive). Wire: cmp rdi, 0; je vtb_match_all; cmp rdi, 1; je vtb_match_panic; cmp rdi, 2; je vtb_match_err; cmp rdi, 3; je vtb_match_warn; cmp rdi, 4; je vtb_match_info; xor rax, rax; ret. Match arms: vtb_match_all: mov rax, 1; ret. vtb_match_panic: cmp rsi, 0; je vtb_match_yes; jmp vtb_match_no. vtb_match_err: cmp rsi, 1; je vtb_match_yes; jmp vtb_match_no. vtb_match_warn: cmp rsi, 2; je vtb_match_yes; jmp vtb_match_no. vtb_match_info: cmp rsi, 3; je vtb_match_yes; jmp vtb_match_no. vtb_match_yes: mov rax, 1; ret. vtb_match_no: xor rax, rax; ret. Encoder discipline: no `test` (every zero-check via cmp reg, 0); no imul; no `and reg, imm`; no `cmp reg, [mem]` (all compares are reg-to-imm8); no lea (register-only, so no r11-clobber concern); no cross-module call. Every immediate (0, 1, 2, 3, 4) fits imm8. Effect `!{}` (no memory read, no memory write, no sysreg). Return values are strictly 0 or 1. Labels prefixed vtb_match_ per fingerprint discipline (substring `loop` avoided).",
      block: {
        // ---- Dispatch by `selected` ----------------------------------------
        cmp rdi, 0;
        je vtb_match_all;
        cmp rdi, 1;
        je vtb_match_panic;
        cmp rdi, 2;
        je vtb_match_err;
        cmp rdi, 3;
        je vtb_match_warn;
        cmp rdi, 4;
        je vtb_match_info;
        // Out of range (selected >= 5): return 0.
        xor rax, rax;
        ret;

      vtb_match_all:
        // "All" tab matches every severity unconditionally.
        mov rax, 1;
        ret;

      vtb_match_panic:
        cmp rsi, 0;                                // LEVEL_PANIC
        je vtb_match_yes;
        jmp vtb_match_no;

      vtb_match_err:
        cmp rsi, 1;                                // LEVEL_ERROR
        je vtb_match_yes;
        jmp vtb_match_no;

      vtb_match_warn:
        cmp rsi, 2;                                // LEVEL_WARN
        je vtb_match_yes;
        jmp vtb_match_no;

      vtb_match_info:
        cmp rsi, 3;                                // LEVEL_INFO
        je vtb_match_yes;
        jmp vtb_match_no;

      vtb_match_yes:
        mov rax, 1;
        ret;

      vtb_match_no:
        xor rax, rax;
        ret;
      }
    }

}
