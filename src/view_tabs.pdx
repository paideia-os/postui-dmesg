// src/view_tabs.pdx -- postui-dmesg.M3-002 (paideia-os/postui-dmesg#4)
//
// ViewTabs module: 5-tab horizontal strip
// [All | Panic | Err | Warn | Info] gluing postui.M2-007 tabs_draw to
// a persistent selected-tab index.
//
// =============================================================================
// SCOPE (postui/docs/design.md §3.3 postui-dmesg reference app, M3-002 slot)
// =============================================================================
//
// M3-002 lands the second widget of the postui-dmesg top-level UI: a
// horizontal tab bar that toggles the log-line view between five
// severity-filter modes. The rendered strip lives at the top of the
// terminal (row 0, full width, height 1); the selected tab index is
// persisted in a module-private one-slot BSS cell (_vt_tabs_state[0])
// so that a key-handler landing at M3-003+ can advance it via
// view_tabs_next() / view_tabs_prev() between frames without any
// caller-side threading.
//
// The five tabs and their filter semantics (severity match delegated
// to view_tabs_match below):
//
//   index 0  "All"     every log line the ring holds
//   index 1  "Panic"   klog LEVEL_PANIC (integer 0, wire letter 'P')
//   index 2  "Err"     klog LEVEL_ERROR (integer 1, wire letter 'E')
//   index 3  "Warn"    klog LEVEL_WARN  (integer 2, wire letter 'W')
//   index 4  "Info"    klog LEVEL_INFO  (integer 3, wire letter 'I')
//
// The filter *itself* is applied at the caller: view_list.pdx (M2-001)
// reads view_tabs_selected() from the poll_tick post-refresh loop and
// gates each log_line's inclusion via view_tabs_match(selected,
// severity). Splitting selection state from filter application mirrors
// the postui-top M3-002 -> M3-003 discipline (widget draws first,
// dispatch wiring second) and keeps this landing localized to the
// tab-strip UI.
//
// =============================================================================
// SEVERITY ENCODING (kernel LEVEL_* enum, not syslog priorities)
// =============================================================================
//
// The log_line.severity field (KP_LINE_OFF_SEVERITY = 0 in
// klog_poll.pdx) carries the kernel LEVEL_* integer extracted from
// the level field of each klog wire line. The paideia-os klog wire
// grammar (design/kernel/kernel-logging-substrate.md §3.2) is
//
//     log-line = tsc "|" cpu "|" level "|" subsys "|" tag ...
//     level    = "P" / "E" / "W" / "I" / "D" / "T"
//
// so the level slot is a single ASCII letter -- NOT a numeric syslog
// priority. Each letter maps 1:1 to the frozen LEVEL_* integers
// (§4):
//
//   'P' -> LEVEL_PANIC = 0    system unusable            -> tab 1 "Panic"
//   'E' -> LEVEL_ERROR = 1    subsystem broken           -> tab 2 "Err"
//   'W' -> LEVEL_WARN  = 2    unusual state, not a fault -> tab 3 "Warn"
//   'I' -> LEVEL_INFO  = 3    boot markers / witness OK  -> tab 4 "Info"
//   'D' -> LEVEL_DEBUG = 4    tracing (off in prod)      -> (not surfaced)
//   'T' -> LEVEL_TRACE = 5    per-insn (off in prod)     -> (not surfaced)
//
// The parser that lands at KlogPoll M2 stores the LEVEL_* integer
// (0..5) at log_line[+0]; this module's view_tabs_match keys against
// that integer space directly. Values >= 6 map to "no match" (never
// produced by the wire grammar, defensive).
//
// NOTE: at M1-001 klog_poll.pdx sets severity = 0 as a PLACEHOLDER
// for every line (see KP_LINE_OFF_SEVERITY comment in klog_poll.pdx
// L246-254) until the M2 level-letter parser lands. Under the
// placeholder, view_tabs_match against tab 1 "Panic" returns 1 for
// every line (severity=0 == LEVEL_PANIC) and 0 for tabs 2/3/4, so
// the practical effect of tab switching is bounded until M2. This
// module's contract is the future steady state.
//
// The previous revision of this module keyed against a FABRICATED
// syslog priority space (0/3/4/6 for emerg/err/warn/info). No such
// wire encoding exists in paideia-os -- the kernel emits letters
// mapped to the LEVEL_* enum, so the syslog immediates never matched
// any real line. postui-dmesg#8 corrects that: sel=1 keys against 0
// (PANIC), sel=2 against 1 (ERROR), sel=3 against 2 (WARN), sel=4
// against 3 (INFO).
//
// =============================================================================
// DEPENDENCY (postui.M2-007 tabs_draw)
// =============================================================================
//
// This module is a pure consumer of postui/src/widgets/tabs.pdx
// (shipped at postui.M2-007, milestone M2 released with postui
// v1.0.0). The TabsSpec wire format (56 bytes) is the sole cross-
// module contract:
//
//   [+ 0..+ 8)   rect            u64 packed (x, y, w, h)
//   [+ 8..+16)   titles_ptr      u64 -> Span[] array (24 B per Span)
//   [+16..+24)   tab_count       u64
//   [+24..+32)   selected        u64
//   [+32..+40)   divider         u64 packed 4-byte UTF-8 codepoint
//                                (0 elects default U+2502 '|')
//   [+40..+48)   style_active    u64 packed Style
//   [+48..+56)   style_inactive  u64 packed Style
//
// tabs_draw signature (SysV):
//   rdi = spec_ptr, rsi = buf_ptr, rdx = rows, rcx = cols -> rax
//
// The postui Text::Span wire (24 bytes, TEXT_SPAN_BYTES):
//   [+ 0..+ 8)   ptr             u64 byte pointer
//   [+ 8..+16)   byte_len        u64 byte length
//   [+16..+24)   style           u64 packed Style (0 = default)
//
// Both wires are frozen at postui-v1.0.0; the constants in this
// module are bit-for-bit mirrors of postui-top's ViewTabs and any
// wire evolution touches exactly these mirrors plus the widget body.
//
// =============================================================================
// STATIC SCRATCH FOOTPRINT (BSS, zero-initialized at load)
// =============================================================================
//
//   _vt_tabs_state    [u64; 1]     8 B   current tab index (0..4)
//   _vtb_spans        [u8; 120]  120 B   5 Span records (24 B each)
//   _vtb_spec         [u8; 56]    56 B   TabsSpec
//   _vtb_lbl_all      [u8; 3]      3 B   "All"
//   _vtb_lbl_panic    [u8; 5]      5 B   "Panic"
//   _vtb_lbl_err      [u8; 3]      3 B   "Err"
//   _vtb_lbl_warn     [u8; 4]      4 B   "Warn"
//   _vtb_lbl_info     [u8; 4]      4 B   "Info"
//
// Total = 8 + 120 + 56 + 3 + 5 + 3 + 4 + 4 = 203 bytes (<< 4 KiB).
//
// _vt_tabs_state is the ONE piece of module state that survives
// across frames; every other slab is re-stamped by view_tabs_render
// at each call. The label byte arrays are read-only literals; their
// addresses are stable across the module's lifetime so a single lea
// + store into each Span.ptr slot per render is a safe alias (no
// copy needed).
//
// The `_vt_tabs_state` name honors the task specification exactly.
// postui-top's own ViewTabs uses the same name; because postui-top
// and postui-dmesg link into SEPARATE binaries (each is a distinct
// tool per its own manifest.pdxproj), the shared symbol name causes
// no cross-binary collision. Local labels (jump targets) inside
// each function use the `vtb_*` prefix to keep parity with postui-
// top's ViewTabs fingerprint discipline.
//
// =============================================================================
// ENTRY SIGNATURES
// =============================================================================
//
//   view_tabs_render(buf_ptr, rows, cols) -> u64
//     rdi = buf_ptr          VA of a `rows * cols` grid of 16-byte Cells
//     rsi = rows             terminal row count
//     rdx = cols             terminal column count
//     -> rax                 tabs_draw's return propagated verbatim
//                            (0 on OK; TAB_ERR_BAND on defensive
//                            failure)
//     Renders the tab strip at row 0, spanning all `cols` columns.
//
//   view_tabs_next() -> ()
//     No args. Advances the selection: (_vt_tabs_state[0] + 1) mod 5.
//     Wraps 4 -> 0.
//
//   view_tabs_prev() -> ()
//     No args. Retreats the selection: (_vt_tabs_state[0] + 5 - 1) mod 5.
//     Wraps 0 -> 4.
//
//   view_tabs_selected() -> u64
//     No args. Returns _vt_tabs_state[0] in rax. Callers gate their
//     downstream log-line filter on this value.
//
//   view_tabs_match(selected, severity) -> u64
//     rdi = selected         a tab index in [0..5) (values >= 5 map
//                            to "no match", returning 0)
//     rsi = severity         the log_line.severity field (kernel
//                            LEVEL_* integer in [0..6): PANIC=0,
//                            ERROR=1, WARN=2, INFO=3, DEBUG=4,
//                            TRACE=5)
//     -> rax                 1 if severity matches the tab's filter,
//                            0 otherwise. selected==0 ("All") always
//                            returns 1 regardless of severity. Table:
//                              sel=0 -> 1                (all)
//                              sel=1 -> (sev == 0) ? 1:0 (panic)
//                              sel=2 -> (sev == 1) ? 1:0 (err)
//                              sel=3 -> (sev == 2) ? 1:0 (warn)
//                              sel=4 -> (sev == 3) ? 1:0 (info)
//                              sel>=5 -> 0
//
// =============================================================================
// SC+ / KERNEL EFFECT SURFACE
// =============================================================================
//
// ViewTabs issues NO syscalls. view_tabs_render reads through
// _vt_tabs_state / _vtb_spans / _vtb_spec / label bytes (memory),
// writes into the cell buffer via tabs_draw (memory), and dispatches
// tabs_draw with all pointer arguments in userspace. view_tabs_next
// / view_tabs_prev touch a single 8-byte slot each. view_tabs_selected
// reads a single 8-byte slot. view_tabs_match is pure -- no memory
// access at all (register-only). Effect row `!{mem}` @{} for the
// four that touch _vt_tabs_state; `!{}` for view_tabs_match. No
// capability gate.
//
// =============================================================================
// PAIDEIA-AS CONFORMANCE
// =============================================================================
//
//   - Module name PascalCase basename (`ViewTabs`), matches file
//     basename view_tabs.pdx per manifest.pdxproj `module-basename-
//     pascal` compliance flag.
//   - No `test` mnemonic; every zero-check goes through `cmp reg, 0`.
//   - Every immediate in cmp / and fits imm32 (widest is 0xFFFF, the
//     Rect field mask). No sentinel > 0x7FFFFFFF appears in any
//     cmp/and.
//   - No 2-op `imul reg, imm` anywhere; no imul used at all (this
//     module has no per-row multiplication -- the 5 tabs and 1 spec
//     are stamped at fixed offsets).
//   - No `mul` mnemonic; no `and reg, imm64`; no `cmp reg, [mem]`
//     (the mod-5 wrap in view_tabs_next / view_tabs_prev loads
//     through rax first; view_tabs_match's compares are register-
//     to-register or register-to-imm8).
//   - `pub let` single-line declarations only (multiline `pub let
//     ="..."` is a paideia-as pitfall).
//   - Reserved paideia-as keywords (`loop`, `if`, `then`, `else`,
//     `test`) NEVER appear as label names; every label prefixed
//     `vtb_*` per the postui-top fingerprint discipline. Substring
//     "loop" avoided defensively.
//   - r11 discipline: paideia-as's `lea rN, [rip + label]` internally
//     clobbers r11. This module uses `lea r11, [rip + _vt_tabs_state]`
//     in view_tabs_next / view_tabs_prev / view_tabs_selected -- r11
//     IS the target, so the internal clobber is the wanted result.
//     In view_tabs_render, r11 is a per-store scratch that never
//     crosses a lea boundary. view_tabs_match uses no lea (all
//     register-only), so no r11 concern.
//   - Byte load shape: not used in this module (no strnlen scan; the
//     tab labels are compile-time literals with known lengths).
//   - SysV push/pop parity:
//       * view_tabs_render: 3-push callee-save prologue (rbx / r12 /
//         r13 = 24 bytes) -> entry rsp%16==8, +24 == 32 (rsp%16 == 0)
//         for the nested tabs_draw call. No sub rsp; no stack slots
//         needed (all state lives in BSS / registers).
//       * view_tabs_next: pure leaf; no push/pop, no callee-save
//         touched, no nested call.
//       * view_tabs_prev: pure leaf; no push/pop, no callee-save
//         touched, no nested call.
//       * view_tabs_selected: pure leaf; no push/pop, no callee-save
//         touched, no nested call.
//       * view_tabs_match: pure leaf; no push/pop, no callee-save
//         touched, no nested call, no memory access.
//   - Cross-module call convention: bare `call tabs_draw` per the
//     postui-top view_tabs.pdx precedent (`call tabs_draw`) --
//     paideia-as's flat symbol namespace resolves postui's exported
//     symbols by name at link time.

module ViewTabs = structure {

  // ==========================================================================
  // TabsSpec field offsets (mirror of postui/src/widgets/tabs.pdx
  // TABS_OFF_* constants; frozen at postui-v1.0.0). Named locally so
  // view_tabs_render never dereferences the postui symbols directly;
  // any wire evolution updates postui's constants and, in lockstep,
  // this mirror block.
  // ==========================================================================
  pub let VTB_TABS_SPEC_BYTES : u64 = 56

  pub let VTB_TABS_OFF_RECT           : u64 = 0
  pub let VTB_TABS_OFF_TITLES_PTR     : u64 = 8
  pub let VTB_TABS_OFF_TAB_COUNT      : u64 = 16
  pub let VTB_TABS_OFF_SELECTED       : u64 = 24
  pub let VTB_TABS_OFF_DIVIDER        : u64 = 32
  pub let VTB_TABS_OFF_STYLE_ACTIVE   : u64 = 40
  pub let VTB_TABS_OFF_STYLE_INACTIVE : u64 = 48

  // ==========================================================================
  // Text::Span field offsets (mirror of postui/src/text.pdx
  // TEXT_SPAN_OFF_* / TEXT_SPAN_BYTES). Same lockstep discipline.
  // ==========================================================================
  pub let VTB_SPAN_BYTES : u64 = 24

  pub let VTB_SPAN_OFF_PTR      : u64 = 0
  pub let VTB_SPAN_OFF_BYTE_LEN : u64 = 8
  pub let VTB_SPAN_OFF_STYLE    : u64 = 16

  // ==========================================================================
  // Structural constants for this module's fixed 5-tab strip.
  // ==========================================================================
  pub let VTB_TAB_COUNT : u64 = 5
  pub let VTB_TAB_ROW_H : u64 = 1    // strip height in cells (top row only)

  // Selected-index bounds. view_tabs_next wraps ((sel + 1) < BOUND ? sel+1 : 0).
  // view_tabs_prev wraps (sel == 0 ? BOUND-1 : sel - 1).
  pub let VTB_TAB_MOD : u64 = 5

  // ==========================================================================
  // Kernel LEVEL_* sentinels the view_tabs_match table keys against.
  // Named locally so the match body reads at the mnemonic (Panic/Err/
  // Warn/Info) rather than at the raw digit. See §SEVERITY ENCODING
  // above for the wire-format rationale (design/kernel/kernel-logging-
  // substrate.md §3.2 letter grammar + §4 LEVEL_* enum).
  // ==========================================================================
  pub let VTB_SEV_PANIC : u64 = 0
  pub let VTB_SEV_ERR   : u64 = 1
  pub let VTB_SEV_WARN  : u64 = 2
  pub let VTB_SEV_INFO  : u64 = 3

  // Tab-index sentinels the view_tabs_match dispatch keys against.
  // Kept as named constants so the mapping between tab-index and the
  // filter it applies is legible from the source (rather than as a
  // trail of imm8s in the asm body).
  pub let VTB_TAB_ALL   : u64 = 0
  pub let VTB_TAB_PANIC : u64 = 1
  pub let VTB_TAB_ERR   : u64 = 2
  pub let VTB_TAB_WARN  : u64 = 3
  pub let VTB_TAB_INFO  : u64 = 4

  // ==========================================================================
  // Tab label byte arrays. Lengths are hard-coded at each render-site
  // Span-populate block so the emit path never re-reads a length
  // constant (matches postui-top view_tabs.pdx `_vtb_lbl_*`
  // discipline).
  // ==========================================================================
  pub let _vtb_lbl_all   : [u8; 3] = "All"
  pub let _vtb_lbl_panic : [u8; 5] = "Panic"
  pub let _vtb_lbl_err   : [u8; 3] = "Err"
  pub let _vtb_lbl_warn  : [u8; 4] = "Warn"
  pub let _vtb_lbl_info  : [u8; 4] = "Info"

  // ==========================================================================
  // Static scratch (mutable, .bss, zero-initialized at load).
  //
  // _vt_tabs_state is the ONE cross-frame slot -- view_tabs_next /
  // view_tabs_prev mutate it, view_tabs_render / view_tabs_selected
  // read it. _vtb_spans and _vtb_spec are re-stamped by
  // view_tabs_render at each call and carry no state between frames;
  // the module could theoretically build them on the stack, but
  // keeping them in BSS keeps view_tabs_render's stack footprint at
  // zero (no `sub rsp, N` needed).
  //
  // _vtb_spans holds 5 Span records * 24 bytes each = 120 bytes.
  // Span[i] lives at offset i*24; view_tabs_render stamps each of
  // the 5 records at its fixed offset with no per-record loop.
  // ==========================================================================
  pub let mut _vt_tabs_state : [u64; 1]  = uninit @align(8)
  pub let mut _vtb_spans     : [u8; 120] = uninit @align(8)
  pub let mut _vtb_spec      : [u8; 56]  = uninit @align(8)

  // ==========================================================================
  // view_tabs_render(buf_ptr, rows, cols) -> u64
  //
  // Per-frame Tabs draw. Rebuilds the 5-Span titles array + TabsSpec
  // from static labels + persisted selection, then dispatches
  // postui.tabs_draw over the top row (y = 0, h = 1) of the caller's
  // cell buffer.
  //
  // Register plan (3-push callee-save prologue, roles across phases):
  //   rbx = buf_ptr    survives every phase; used as tabs_draw's rsi
  //   r12 = rows       survives every phase; used as tabs_draw's rdx
  //   r13 = cols       survives every phase; used as tabs_draw's rcx
  //                    (also packs into spec.rect.w)
  //
  // Alignment: entry rsp%16 == 8; +24 (3 pushes) == 32 (rsp%16 == 0).
  // Nested tabs_draw call is 16-byte-aligned without any `sub rsp`.
  //
  // Label prefix `vtb_` per postui-top fingerprint discipline. No
  // branches or loops in the body -- straight-line stamping of 5
  // Spans + 7 TabsSpec fields + 1 tail call.
  //
  // Span offsets (24 B stride):
  //   Span 0 (All):   [+  0] ptr [+  8] byte_len [+ 16] style
  //   Span 1 (Panic): [+ 24] ptr [+ 32] byte_len [+ 40] style
  //   Span 2 (Err):   [+ 48] ptr [+ 56] byte_len [+ 64] style
  //   Span 3 (Warn):  [+ 72] ptr [+ 80] byte_len [+ 88] style
  //   Span 4 (Info):  [+ 96] ptr [+104] byte_len [+112] style
  // ==========================================================================
  pub let view_tabs_render : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf_ptr: u64) (rows: u64) (cols: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "postui-dmesg.M3-002 (postui-dmesg#4): view_tabs_render is the per-frame Tabs adapter for the 5-tab severity strip [All|Panic|Err|Warn|Info]. 3-push callee-save prologue (rbx=buf_ptr, r12=rows, r13=cols = 24 bytes) -- entry rsp%16==8, +24==0 for the single nested tabs_draw SysV call; no sub rsp / no stack slots needed (all state in BSS or callee-save regs). Phase 1 (Span stamps into _vtb_spans, 5 records at 24 B stride = 120 B total): lea r10, [rip + _vtb_spans]; for each of 5 tabs stamp (ptr, byte_len, style=0) via `lea r11, [rip + _vtb_lbl_<name>]; mov [r10 + off_ptr], r11; mov rax, <literal_len>; mov [r10 + off_byte_len], rax; xor rax, rax; mov [r10 + off_style], rax`. The `lea r11, [rip + label]` result is the value we want (r11 IS the target), so paideia-as's internal r11-clobber-on-lea is the wanted behavior. Literal lengths (3 for \"All\", 5 for \"Panic\", 3 for \"Err\", 4 for \"Warn\", 4 for \"Info\") all fit imm8; every Span offset (0/8/16 . . . 112) fits imm8. Phase 2 (TabsSpec stamp into _vtb_spec, 56 B): lea r10, [rip + _vtb_spec]; (a) rect: pack (x=0, y=0, w=cols, h=1) as x | y<<16 | w<<32 | h<<48 -- mov r11, r13 (cols); and r11, 0xFFFF (imm32); shl r11, 32 (imm8); mov rax, 1; and rax, 0xFFFF (imm32, defensive); shl rax, 48 (imm8); or r11, rax; mov [r10 + 0], r11 (x=0, y=0 implicit -- entry cells [0..16) and [16..32) unset in the OR chain remain zero because r11 was constructed only from the shifted w and h bits). (b) titles_ptr: lea r11, [rip + _vtb_spans]; mov [r10 + 8], r11. (c) tab_count = 5: mov rax, 5; mov [r10 + 16], rax. (d) selected: lea r11, [rip + _vt_tabs_state]; mov rax, [r11 + 0]; mov [r10 + 24], rax. (e) divider = 0 (elects default U+2502 '|' via tabs_draw's fixup): xor rax, rax; mov [r10 + 32], rax. (f, g) style_active = 0, style_inactive = 0 (default black-on-white unstyled per Style module wire): mov [r10 + 40], rax; mov [r10 + 48], rax. Phase 3 (dispatch): lea rdi, [rip + _vtb_spec]; mov rsi, rbx (buf_ptr); mov rdx, r12 (rows); mov rcx, r13 (cols); call tabs_draw. rax carries tabs_draw's return verbatim (0 on OK; TAB_ERR_BAND on defensive failure). Epilogue: 3-pop; ret. Encoder discipline: no `test` (no zero-checks in this body); no `and reg, imm64` (widest mask 0xFFFF, imm32); no `imul` (no per-row multiplications -- the 5-tab strip stamps into fixed offsets); no `mul`; no `cmp reg, [mem]` (no compares at all in this body). Every immediate (0, 1, 3, 4, 5, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 112, 0xFFFF) fits imm32; every shift count (16, 32, 48) is imm8. r11 discipline: r11 is used as scratch across the body; every `lea r11, [rip + label]` places the wanted label address into r11 and the internal r11-clobber-on-lea is the exact behavior we depend on. NON-target `lea rN, [rip + ...]` (only two: `lea r10, [rip + _vtb_spans]` at phase 1 start and `lea r10, [rip + _vtb_spec]` at phase 2 start, plus `lea rdi, [rip + _vtb_spec]` at phase 3) clobber r11 but no value of r11 needs to survive those (the next r11 use is another lea into r11). Effect `!{mem}` (spec/span/label reads, spec/span stores, transitive tabs_draw cell writes). Labels prefixed vtb_ per postui fingerprint discipline (no labels needed for this straight-line body).",
      block: {
        push rbx;
        push r12;
        push r13;

        mov rbx, rdi;                              // buf_ptr
        mov r12, rsi;                              // rows
        mov r13, rdx;                              // cols

        // ---- Phase 1: Span stamps (5 tabs into _vtb_spans) -----------------
        lea r10, [rip + _vtb_spans];

        // Span 0: "All" (3 bytes)
        lea r11, [rip + _vtb_lbl_all];
        mov [r10 + 0],   r11;                      // span[0].ptr
        mov rax, 3;
        mov [r10 + 8],   rax;                      // span[0].byte_len
        xor rax, rax;
        mov [r10 + 16],  rax;                      // span[0].style = 0

        // Span 1: "Panic" (5 bytes)
        lea r11, [rip + _vtb_lbl_panic];
        mov [r10 + 24],  r11;                      // span[1].ptr
        mov rax, 5;
        mov [r10 + 32],  rax;                      // span[1].byte_len
        xor rax, rax;
        mov [r10 + 40],  rax;                      // span[1].style = 0

        // Span 2: "Err" (3 bytes)
        lea r11, [rip + _vtb_lbl_err];
        mov [r10 + 48],  r11;                      // span[2].ptr
        mov rax, 3;
        mov [r10 + 56],  rax;                      // span[2].byte_len
        xor rax, rax;
        mov [r10 + 64],  rax;                      // span[2].style = 0

        // Span 3: "Warn" (4 bytes)
        lea r11, [rip + _vtb_lbl_warn];
        mov [r10 + 72],  r11;                      // span[3].ptr
        mov rax, 4;
        mov [r10 + 80],  rax;                      // span[3].byte_len
        xor rax, rax;
        mov [r10 + 88],  rax;                      // span[3].style = 0

        // Span 4: "Info" (4 bytes)
        lea r11, [rip + _vtb_lbl_info];
        mov [r10 + 96],  r11;                      // span[4].ptr
        mov rax, 4;
        mov [r10 + 104], rax;                      // span[4].byte_len
        xor rax, rax;
        mov [r10 + 112], rax;                      // span[4].style = 0

        // ---- Phase 2: TabsSpec stamp into _vtb_spec ------------------------
        lea r10, [rip + _vtb_spec];

        // (a) rect: (x=0, y=0, w=cols, h=1)  packed as x | y<<16 | w<<32 | h<<48
        mov r11, r13;                              // cols
        and r11, 0xFFFF;
        shl r11, 32;                               // w << 32
        mov rax, 1;
        and rax, 0xFFFF;
        shl rax, 48;                               // h << 48
        or  r11, rax;                              // x=0, y=0 implicit
        mov [r10 + 0], r11;                        // VTB_TABS_OFF_RECT

        // (b) titles_ptr
        lea r11, [rip + _vtb_spans];
        mov [r10 + 8], r11;                        // VTB_TABS_OFF_TITLES_PTR

        // (c) tab_count = 5
        mov rax, 5;
        mov [r10 + 16], rax;                       // VTB_TABS_OFF_TAB_COUNT

        // (d) selected = _vt_tabs_state[0]
        lea r11, [rip + _vt_tabs_state];
        mov rax, [r11 + 0];
        mov [r10 + 24], rax;                       // VTB_TABS_OFF_SELECTED

        // (e) divider = 0 (elects default U+2502 '|' via tabs_draw fixup)
        xor rax, rax;
        mov [r10 + 32], rax;                       // VTB_TABS_OFF_DIVIDER

        // (f) style_active = 0 (default)
        mov [r10 + 40], rax;                       // VTB_TABS_OFF_STYLE_ACTIVE

        // (g) style_inactive = 0 (default)
        mov [r10 + 48], rax;                       // VTB_TABS_OFF_STYLE_INACTIVE

        // ---- Phase 3: dispatch tabs_draw -----------------------------------
        lea rdi, [rip + _vtb_spec];
        mov rsi, rbx;                              // buf_ptr
        mov rdx, r12;                              // rows
        mov rcx, r13;                              // cols
        call tabs_draw;

        // rax carries tabs_draw's return verbatim
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // view_tabs_next() -> ()
  //
  // Advance the selected-tab index: sel = (sel + 1) mod 5. Wraps
  // 4 -> 0.
  //
  // Contract:
  //   No args.
  //   -> rax                 undefined (void; caller must not rely
  //                          on it)
  //
  // Register plan: pure leaf. r11 = _vt_tabs_state address (the `lea
  // r11, [rip + label]` result IS the wanted value, so paideia-as's
  // internal r11-clobber-on-lea is the wanted behavior). rax =
  // working sel value. No pushes, no nested call.
